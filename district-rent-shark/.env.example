# Required
TINYFISH_API_KEY=your_tinyfish_api_key

# Optional — Canary: use Fetch→extractor pipeline + Search fallback in /api/search
# Default (unset): legacy Agent streaming only
TINYFISH_FETCH_FIRST_PIPELINE=0

# Optional — Mapbox map (hidden if missing)
NEXT_PUBLIC_MAPBOX_TOKEN=

# Optional — Supabase caching (app works without these)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
